{
  "uid": "foresight-api",
  "title": "foresight API",
  "description": "Request rate, latency, forecast outcomes, and which model version is being served.",
  "tags": ["foresight", "forecasting"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Model version served",
      "description": "Read from the foresight_model_info label, so a retrain that swaps the artifact shows up here.",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "foresight-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "foresight_model_info",
          "legendFormat": "{{version}}",
          "instant": true
        }
      ],
      "options": {
        "textMode": "name",
        "colorMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Series served",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "foresight-prometheus" },
      "targets": [{ "refId": "A", "expr": "foresight_series_served", "instant": true }],
      "options": {
        "colorMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Error ratio (5m)",
      "description": "Share of requests answering 4xx or 5xx. A 404 here usually means a caller asked for a series this model does not serve.",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "foresight-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(foresight_http_requests_total{status=~\"4..|5..\"}[5m])) / clamp_min(sum(rate(foresight_http_requests_total[5m])), 1e-9)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.05 },
              { "color": "red", "value": 0.2 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Requests per second (5m)",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "foresight-prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum(rate(foresight_http_requests_total[5m]))" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "decimals": 2 }, "overrides": [] },
      "options": {
        "colorMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Request rate by route and status",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "foresight-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (route, status) (rate(foresight_http_requests_total[5m]))",
          "legendFormat": "{{route}} {{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10 }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean"] } }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Latency percentiles on /forecast",
      "description": "Quantiles over the histogram buckets. A forecast loops once per horizon day, so p99 rising with no traffic change usually means callers asking for longer horizons rather than the service slowing down. The horizon panel below separates those.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "foresight-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(foresight_http_request_duration_seconds_bucket{route=\"/forecast\"}[5m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(foresight_http_request_duration_seconds_bucket{route=\"/forecast\"}[5m])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(foresight_http_request_duration_seconds_bucket{route=\"/forecast\"}[5m])))",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 0 }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Forecast outcomes",
      "description": "Successful forecasts against requests for a series the loaded model does not know. A rising unknown_series rate is a sign the served model is narrower than what callers expect.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "foresight-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(foresight_forecasts_total[5m]))",
          "legendFormat": "{{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "drawStyle": "bars", "lineWidth": 1, "fillOpacity": 60, "stacking": { "mode": "normal" } }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Requested horizon",
      "description": "Median and 95th percentile of the horizon callers ask for, in days. Read alongside the latency panel: cost per request scales with horizon.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "foresight-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(foresight_forecast_horizon_days_bucket[30m])))",
          "legendFormat": "p50 horizon"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(foresight_forecast_horizon_days_bucket[30m])))",
          "legendFormat": "p95 horizon"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "d",
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 0 }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    }
  ]
}
